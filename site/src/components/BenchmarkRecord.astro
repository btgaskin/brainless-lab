---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Statistic {
  case: string;
  condition: string;
  n: number;
  raw_mean: number;
  raw_ci_lower: number;
  raw_ci_upper: number;
  normalized_mean: number;
  normalized_ci_lower: number;
  normalized_ci_upper: number;
  normalized_censoring: string;
}

interface ProfileSummary {
  condition: string;
  blocks: number;
  trials: number;
  raw_score_mean: number;
  normalized_score_mean: number;
  normalized_censoring: string;
}

interface BenchmarkSummary {
  statistics: Statistic[];
  contrasts: unknown[];
}

interface Props {
  recordPath: string;
}

const { recordPath } = Astro.props;
const candidates = [process.cwd(), resolve(process.cwd(), '..')];
const repositoryRoot = candidates.find((candidate) => {
  try {
    readFileSync(resolve(candidate, 'Project.toml'));
    readFileSync(resolve(candidate, 'site', 'package.json'));
    return true;
  } catch {
    return false;
  }
});

if (!repositoryRoot) {
  throw new Error('cannot locate the BrainlessLab repository root');
}

const summary = JSON.parse(
  readFileSync(resolve(repositoryRoot, recordPath, 'summary', 'summary.json'), 'utf8'),
) as ProfileSummary | BenchmarkSummary;
const record = readFileSync(resolve(repositoryRoot, recordPath, 'record.toml'), 'utf8');
const field = (name: string) =>
  record.match(new RegExp(`^${name} = "([^"]+)"$`, 'm'))?.[1] ?? 'unknown';
const kind = field('kind');
if (kind !== 'profile' && kind !== 'benchmark') {
  throw new Error(`unsupported example record kind: ${kind}`);
}
const profile = kind === 'profile' ? (summary as ProfileSummary) : null;
const benchmark = kind === 'benchmark' ? (summary as BenchmarkSummary) : null;
const statistics = readFileSync(
  resolve(repositoryRoot, recordPath, 'summary', 'statistics.csv'),
  'utf8',
);
const statisticsRows = statistics.trim() === '' ? 0 : statistics.trim().split('\n').length - 1;
const headingId = `${kind}-example-record`;
const format = (value: number) => value.toFixed(3);
---

<section class="benchmark-record" aria-labelledby={headingId}>
  <h2 id={headingId}>Example {kind} record</h2>
  <p>
    This dummy fixture illustrates the record format. It establishes nothing about
    performance. The values below are read from its machine-readable summary during the
    site build.
  </p>
  {
    profile ? (
      <div class="table-wrap">
        <table>
          <thead>
          <tr>
            <th>Condition</th>
            <th>Blocks</th>
            <th>Trials</th>
            <th>Raw mean</th>
            <th>Normalised mean</th>
            <th>Anchor censoring</th>
          </tr>
          </thead>
          <tbody>
            <tr>
              <th>{profile.condition}</th>
              <td>{profile.blocks}</td>
              <td>{profile.trials}</td>
              <td>{format(profile.raw_score_mean)}</td>
              <td>{format(profile.normalized_score_mean)}</td>
              <td>{profile.normalized_censoring}</td>
            </tr>
          </tbody>
        </table>
      </div>
    ) : null
  }
  {
    benchmark ? (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Task</th>
              <th>Condition</th>
              <th>Blocks</th>
              <th>Raw mean [95% CI]</th>
              <th>Normalised mean [95% CI]</th>
              <th>Anchor censoring</th>
            </tr>
          </thead>
          <tbody>
            {benchmark.statistics.map((row) => (
              <tr>
                <th>{row.case}</th>
                <td>{row.condition}</td>
                <td>{row.n}</td>
                <td>
                  {format(row.raw_mean)} [{format(row.raw_ci_lower)}, {format(row.raw_ci_upper)}]
                </td>
                <td>
                  {format(row.normalized_mean)} [{format(row.normalized_ci_lower)},{' '}
                  {format(row.normalized_ci_upper)}]
                </td>
                <td>{row.normalized_censoring}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : null
  }
  {
    profile ? (
      <p>
        <code>summary/statistics.csv</code> contains {statisticsRows} rows because statistics
        and contrasts are benchmark artifacts. Profile results remain visible in{' '}
        <code>data/trials.csv</code> and <code>summary/summary.json</code>.
      </p>
    ) : null
  }
  {
    benchmark ? (
      <p>
        <code>summary/statistics.csv</code> contains {statisticsRows} row. The record contains{' '}
        {benchmark.contrasts.length} contrasts because this anchor-only benchmark declares no
        comparator.
      </p>
    ) : null
  }
</section>

<style>
  .benchmark-record {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  .benchmark-record h2 {
    margin-top: 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 44rem;
  }
</style>
