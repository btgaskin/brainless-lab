      <a href="/tutorials/first-simulation/">Run your first simulation <span aria-hidden="true">↗</span></a>
      <a href="/benchmarks/tasks/">Explore tasks and models <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="bl-home-visual">
    <NeuronRecording />
  </div>
</section>
