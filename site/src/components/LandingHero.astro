---
import NeuronRecording from './NeuronRecording.astro';
import '../styles/home.css';
---

<section class="bl-home-opening" aria-labelledby="_top">
  <div class="bl-home-copy">
    <h1 id="_top" data-page-title>BrainlessLab</h1>
    <p class="bl-home-description">Build a neuron. Explore what happens when neurons interact.</p>
    <p class="bl-home-runtime">Define how neurons respond, connect and adapt. Put them in a task, change the conditions, and study the behaviour that emerges.</p>
    <div class="bl-home-actions">
      <a href="/tutorials/first-simulation/">Run your first simulation <span aria-hidden="true">↗</span></a>
      <a href="/benchmarks/tasks/">Explore tasks and models <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="bl-home-visual">
    <NeuronRecording />
  </div>
</section>
