---
const desktop = '/media/neuron-growth-desktop.mp4';
const mobile = '/media/neuron-growth-mobile.mp4';
const poster = '/media/neuron-growth-poster.webp';
const source = 'https://www.youtube.com/watch?v=0rfi_OL6_x4';
const description = 'Time-lapse microscopy of rat hippocampal neurons extending and retracting processes';
---

<neuron-recording class="neuron-recording" data-desktop={desktop} data-mobile={mobile}>
  <div class="recording-field">
    <div class="recording-square">
      <video class="recording-video recording-enhanced" width="768" height="768" controls muted playsinline preload="none" poster={poster} aria-label={description}>
        <a href={desktop}>Watch the neuron growth recording</a>
      </video>
      <noscript>
        <style is:inline>.recording-enhanced { display: none !important; }</style>
        <video class="recording-video recording-native" width="768" height="768" controls muted playsinline preload="none" poster={poster} aria-label={description}>
          <source src={mobile} type="video/mp4" media="(max-width: 50rem)" />
          <source src={desktop} type="video/mp4" />
          <a href={desktop}>Watch the neuron growth recording</a>
        </video>
      </noscript>
      <div class="recording-attribution">
        <a class="recording-credit" href={source} target="_blank" rel="noopener noreferrer">
          © Louis Romette &amp; Christophe Leterrier<br />
          <span>Aix-Marseille Université / Institut de NeuroPhysioPathologie</span>
        </a>
        <p class="recording-caption">Time-lapse microscopy of rat hippocampal neurons.</p>
      </div>
    </div>
  </div>
  <p class="recording-status" role="status" hidden></p>
</neuron-recording>

<script>
  import './recording-controller';
</script>

<style>
  neuron-recording {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    color: #343434;
  }
  .recording-field {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    container-type: size;
    background: var(--bl-paper, #f8f8f6);
  }
  .recording-square {
    position: relative;
    width: min(100cqw, 100cqh);
    height: min(100cqw, 100cqh);
    transform: translateY(-1rem);
  }
  .recording-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .recording-enhanced {
    cursor: pointer;
    -webkit-mask-image: radial-gradient(circle closest-side, #000 54%, rgba(0, 0, 0, 0.85) 66%, transparent 94%);
    mask-image: radial-gradient(circle closest-side, #000 54%, rgba(0, 0, 0, 0.85) 66%, transparent 94%);
  }
  .recording-square:has(.recording-enhanced:focus-visible) {
    outline: 2px solid #343434;
    outline-offset: 3px;
  }
  .recording-square > noscript { display: contents; }
  .recording-attribution {
    position: absolute;
    opacity: 0.8;
    right: 1.25rem;
    bottom: 1.25rem;
    max-width: calc(100% - 2.5rem);
    color: inherit;
    text-align: right;
    font: 12px/1.45 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .recording-credit { color: inherit; text-decoration: none; }
  .recording-credit span { font-size: 11px; color: #4b4b4b; }
  .recording-credit:hover { text-decoration: underline; }
  .recording-credit:focus-visible { outline: 2px solid #222; outline-offset: 3px; }
  .recording-status[hidden] { display: none; }
  .recording-caption { margin: 0.5rem 0 0; }
  .recording-status { margin: 0; padding: 0 1rem 0.6rem; font-size: 12px; }
  @media (max-width: 55.999rem) {
    .recording-field { flex: none; aspect-ratio: 1; }
    .recording-square { transform: translateY(-0.75rem); }
    .recording-attribution { right: 0.875rem; bottom: 0.875rem; max-width: calc(100% - 1.75rem); }
  }
</style>
