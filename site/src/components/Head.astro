---
import DefaultHead from '@astrojs/starlight/components/Head.astro';

const entryId = Astro.locals.starlightRoute.entry.id;
const isHome = !entryId || entryId === 'index';
const routeId = !entryId || entryId === '404' ? 'index' : entryId;
const ogImage = new URL(`/og/${routeId}.png`, Astro.site ?? Astro.url.origin).href;
const imageUrl = isHome ? `${ogImage}?v=0.4.0-neurons` : ogImage;
const imageAlt = isHome
  ? 'BrainlessLab. Build a neuron. Explore what happens when neurons interact. Neuron microscopy beside the title.'
  : `${Astro.locals.starlightRoute.entry.data.title} — BrainlessLab`;
---

<DefaultHead />
{isHome && <link rel="preload" as="image" href="/media/neuron-growth-poster.webp" type="image/webp" fetchpriority="high" />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
